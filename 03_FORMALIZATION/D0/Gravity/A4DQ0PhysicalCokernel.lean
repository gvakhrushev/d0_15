    residual2 ell7Bar cross7_3 / 92 = (1/46 : ℝ) := by
  rw [orbit7_raw_residuals.1, orbit7_raw_residuals.2.1,
      orbit7_raw_residuals.2.2.1, orbit7_raw_residuals.2.2.2]
