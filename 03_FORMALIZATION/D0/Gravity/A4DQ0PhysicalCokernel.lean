  have hz := leftPair_mulVec_zero p5 ell5Bar ell5_annihilates_cols x
  rw [hx] at hz
  norm_num [leftPair, ell5Bar, cross5_0, qi, Fin.sum_univ_succ, Complex.ext_iff] at hz

