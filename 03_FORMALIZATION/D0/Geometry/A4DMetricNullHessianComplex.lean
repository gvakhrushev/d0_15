theorem minor00_mul_adj (d : Fin 4 → ℚ) :
    minor00 d * adj00 d = delta00 d • (1 : Matrix (Fin 9) (Fin 9) ℚ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [minor00, adj00, delta00, rows00, cols00, C, cCoeff,
      Matrix.mul_apply, dotProduct, Fin.sum_univ_succ] <;> ring

lemma rank_minor00_of_delta_ne_zero (d : Fin 4 → ℚ) (hδ : delta00 d ≠ 0) :
    Matrix.rank (minor00 d) = 9 := by
  have hinv : minor00 d * ((delta00 d)⁻¹ • adj00 d) =
      (1 : Matrix (Fin 9) (Fin 9) ℚ) := by
    rw [Matrix.mul_smul, minor00_mul_adj]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hδ]
  have hlower : 9 ≤ Matrix.rank (minor00 d) := by
    have h := Matrix.rank_mul_le_left (minor00 d) ((delta00 d)⁻¹ • adj00 d)
    rw [hinv] at h
    simpa using h
  exact le_antisymm (by simpa using Matrix.rank_le_width (minor00 d)) hlower

