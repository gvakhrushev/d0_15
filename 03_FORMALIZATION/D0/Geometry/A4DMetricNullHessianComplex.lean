  | 6, 5 => -(d 0)^2*((d 0) - (d 3))*((d 0) + (d 3))*((d 0)^4 + (d 0)^2*(d 2)^2 - (d 0)^2*(d 3)^2 + (d 2)^2*(d 3)^2)/256
  | 6, 6 => -(d 0)^2*(d 2)*(d 3)*((d 0) - (d 2))*((d 0) + (d 2))*((d 0) - (d 3))*((d 0) + (d 3))/128
  | 6, 8 => (d 0)^2*((d 0) - (d 3))*((d 0) + (d 3))*((d 0)^4 + (d 0)^2*(d 2)^2 - (d 0)^2*(d 3)^2 + (d 2)^2*(d 3)^2)/256
  | 7, 0 => -(d 0)^2*(d 2)*(d 3)*((d 0) - (d 3))^2*((d 0) + (d 3))^2/256
  | 7, 3 => -(d 0)^5*(d 3)*((d 0) - (d 3))*((d 0) + (d 3))/128
