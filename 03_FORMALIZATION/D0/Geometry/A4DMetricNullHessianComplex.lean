theorem minor30_mul_adj (d : Fin 4 → ℚ) :
    minor30 d * adj30 d = delta30 d • (1 : Matrix (Fin 9) (Fin 9) ℚ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [minor30, adj30, delta30, rows30, cols30, C, cCoeff,
      Matrix.mul_apply, dotProduct, Fin.sum_univ_succ] <;> ring

lemma rank_minor30_of_delta_ne_zero (d : Fin 4 → ℚ) (hδ : delta30 d ≠ 0) :
    Matrix.rank (minor30 d) = 9 := by
  have hinv : minor30 d * ((delta30 d)⁻¹ • adj30 d) =
      (1 : Matrix (Fin 9) (Fin 9) ℚ) := by
    rw [Matrix.mul_smul, minor30_mul_adj]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hδ]
  have hlower : 9 ≤ Matrix.rank (minor30 d) := by
    have h := Matrix.rank_mul_le_left (minor30 d) ((delta30 d)⁻¹ • adj30 d)
    rw [hinv] at h
    simpa using h
  exact le_antisymm (by simpa using Matrix.rank_le_width (minor30 d)) hlower


