  | 3, 6 => (d 0)^2*(d 1)^2*(d 2)*(d 3)*((d 0) - (d 3))*((d 0) + (d 3))/128
  | 3, 7 => (d 0)^5*(d 1)*((d 0) - (d 3))*((d 0) + (d 3))/128
  | 3, 8 => (d 0)^2*((d 0) - (d 3))*((d 0) + (d 3))*((d 0)^4 + (d 0)^2*(d 1)^2 - (d 0)^2*(d 3)^2 + (d 1)^2*(d 3)^2)/256
  | 4, 0 => -(d 0)^2*(d 1)*(d 2)*((d 0) - (d 3))^2*((d 0) + (d 3))^2/256
  | 4, 1 => -(d 0)^4*((d 0) - (d 3))^2*((d 0) + (d 3))^2/128
  | 4, 2 => -(d 0)^4*(d 2)*(d 3)*((d 0) - (d 3))*((d 0) + (d 3))/128
  | 4, 4 => (d 0)^3*(d 1)*(d 2)*(d 3)*((d 0) - (d 3))*((d 0) + (d 3))/128
  | 4, 5 => -(d 0)^2*(d 1)*(d 2)*((d 0) - (d 3))*((d 0) + (d 3))*((d 0)^2 + (d 3)^2)/256
  | 4, 6 => (d 0)^2*(d 1)*(d 2)^2*(d 3)*((d 0) - (d 3))*((d 0) + (d 3))/128
  | 4, 7 => (d 0)^5*(d 2)*((d 0) - (d 3))*((d 0) + (d 3))/128
