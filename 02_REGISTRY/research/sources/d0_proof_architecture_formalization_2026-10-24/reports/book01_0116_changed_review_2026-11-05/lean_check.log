D0.Foundation.VerificationCore.SigmaWitness.delta_dmin_iff {F : FutureExecution}
  {E : TheoryVerification F.futureEmpiricalTheory} (W : SigmaWitness E) (s t : F.State) :
  W.coding.delta (W.dmin s) (W.dmin t) = true ↔ F.profile s ≠ F.profile t
D0.Foundation.VerificationCore.SigmaWitness.coded_verification_core {F : FutureExecution}
  {E : TheoryVerification F.futureEmpiricalTheory} (W : SigmaWitness E) :
  FunctionalTuple E.protocol ∧
    (∀ (s t : F.State), W.dmin s = W.dmin t ↔ F.profile s = F.profile t) ∧
      (∀ (s t : F.State), W.coding.delta (W.dmin s) (W.dmin t) = true ↔ F.profile s ≠ F.profile t) ∧
        (∀ (s t : F.State) (l l' : E.protocol.Line),
            W.archiveCode (s, l) = W.archiveCode (t, l') ↔ F.profile s = F.profile t ∧ l = l') ∧
          Computable W.coding.canon ∧ Computable₂ W.coding.delta ∧ Computable₂ W.query
D0.Foundation.VerificationCore.SigmaWitness.archiveCode_eq_iff {F : FutureExecution}
  {E : TheoryVerification F.futureEmpiricalTheory} (W : SigmaWitness E) (s t : F.State) (l l' : E.protocol.Line) :
  W.archiveCode (s, l) = W.archiveCode (t, l') ↔ F.profile s = F.profile t ∧ l = l'
D0.Foundation.VerificationCore.SigmaWitness.query_archive {F : FutureExecution}
  {E : TheoryVerification F.futureEmpiricalTheory} (W : SigmaWitness E) (history : List (F.State × E.protocol.Line))
  (n : ℕ) : W.query (W.archive history) n = Option.map W.archiveCode history[n]?
D0.Foundation.FutureShortlexAdapter.hiddenBit_current_same_but_codes_different :
  hiddenBitExecution.observe (false, false) () = hiddenBitExecution.observe (false, true) () ∧
    D0.Foundation.FutureShortlexAdapter.stateCode hiddenBitExecution D0.Foundation.FutureShortlexAdapter.pairDecode
        D0.Foundation.FutureShortlexAdapter.pairEncode (false, false) ≠
      D0.Foundation.FutureShortlexAdapter.stateCode hiddenBitExecution D0.Foundation.FutureShortlexAdapter.pairDecode
        D0.Foundation.FutureShortlexAdapter.pairEncode (false, true)
