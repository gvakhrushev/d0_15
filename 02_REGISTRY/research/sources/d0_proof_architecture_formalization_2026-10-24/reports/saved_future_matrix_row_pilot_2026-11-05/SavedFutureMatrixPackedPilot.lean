import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Matrix.Mul
import Mathlib.Tactic

/-! One-row candidate on packed saved numerical data. No source bridge. -/
namespace D0.Algebra.SavedFutureMatrixPacked

def dataA : ByteArray := ("" : String).toUTF8

def dataB : ByteArray := ("" : String).toUTF8

def digit (xs : ByteArray) (k : Nat) : Nat := (xs.get! k).toNat - 48

def entry (xs : ByteArray) (i j : Fin 128) : ZMod 1009 :=
  let k := 4 * (128 * i.val + j.val)
  (1000 * digit xs k + 100 * digit xs (k + 1) +
    10 * digit xs (k + 2) + digit xs (k + 3) : Nat)

def A : Matrix (Fin 128) (Fin 128) (ZMod 1009) := entry dataA
def B : Matrix (Fin 128) (Fin 128) (ZMod 1009) := entry dataB

-- Resource-bounded candidate; no theorem until the pilot succeeds.
theorem first_row_right_inverse : ∀ j : Fin 128,
    (A * B) 0 j = (1 : Matrix (Fin 128) (Fin 128) (ZMod 1009)) 0 j := by
  native_decide

end D0.Algebra.SavedFutureMatrixPacked

