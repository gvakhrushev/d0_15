  (F : FutureExecution) (dec : List Symbol → F.State) (enc : F.State → List Symbol)
  (correct : ∀ (s : F.State), F.profile (dec (enc s)) = F.profile s)
  (E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory) (s t : F.State) :
  stateCode F dec enc s = stateCode F dec enc t ↔ representedRecord E s = representedRecord E t
