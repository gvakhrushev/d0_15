D0.Foundation.VerificationCore.sufficient_memory_preserves_record {F : FutureExecution}
  (E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory) {Memory : Type}
  (encode : F.State → Memory) (decode : Memory → List F.Action → F.Test → F.Outcome)
  (correct : ∀ (s : F.State), decode (encode s) = F.profile s) {s t : F.State} (h : encode s = encode t) :
  representedRecord E s = representedRecord E t
