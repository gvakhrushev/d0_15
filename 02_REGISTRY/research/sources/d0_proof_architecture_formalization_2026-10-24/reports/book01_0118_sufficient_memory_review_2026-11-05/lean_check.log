theorem D0.Foundation.FutureShortlexAdapter.stateCode_eq_iff_record : ∀ {Symbol : Type} [inst : LinearOrder Symbol]
  [inst_1 : WellFoundedLT Symbol] (F : FutureExecution) (dec : List Symbol → F.State) (enc : F.State → List Symbol),
  (∀ (s : F.State), F.profile (dec (enc s)) = F.profile s) →
    ∀ (E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory) (s t : F.State),
      stateCode F dec enc s = stateCode F dec enc t ↔ representedRecord E s = representedRecord E t :=
fun {Symbol} [LinearOrder Symbol] [WellFoundedLT Symbol] F dec enc correct E s t =>
  {
    mp := fun h =>
      sufficient_memory_preserves_record E (stateCode F dec enc) (fun code => F.profile (dec code))
        (fun x => Eq.trans (canon_profile F dec (enc x)) (correct x)) h,
    mpr := fun h => (stateCode_eq_iff F dec enc correct s t).mpr ((representedRecord_eq_iff E s t).mp h) }
