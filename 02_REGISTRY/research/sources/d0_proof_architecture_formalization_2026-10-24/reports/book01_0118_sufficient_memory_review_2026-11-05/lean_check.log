  {C : Type} (encode : F.State → C) (decode : C → List F.Action → F.Test → F.Outcome)
  (correct : ∀ (s : F.State), decode (encode s) = F.profile s) {s t : F.State} (heq : encode s = encode t) : ⟦s⟧ = ⟦t⟧
D0.Foundation.VerificationCore.representedRecord_eq_iff {F : FutureExecution}
  (E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory) (s t : F.State) :
  representedRecord E s = representedRecord E t ↔ F.profile s = F.profile t
