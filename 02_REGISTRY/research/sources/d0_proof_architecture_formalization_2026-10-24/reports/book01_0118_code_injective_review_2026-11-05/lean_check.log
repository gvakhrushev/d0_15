D0.Foundation.VerificationCore.CodePresentation (Symbol Object : Type) [LinearOrder Symbol] : Type
D0.Foundation.VerificationCore.CodePresentation.decode_encode {Symbol Object : Type} [LinearOrder Symbol]
  (self : CodePresentation Symbol Object) (x : Object) : self.decode (self.encode x) = some x
D0.Foundation.VerificationCore.CodePresentation.encode_injective {Symbol Object : Type} [LinearOrder Symbol]
  (K : CodePresentation Symbol Object) : Function.Injective K.encode
D0.Foundation.VerificationCore.SigmaWitness.dmin_eq_iff {F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution}
  {E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory} (W : SigmaWitness E)
  (s t : F.State) : W.dmin s = W.dmin t ↔ F.profile s = F.profile t
D0.Foundation.VerificationCore.SigmaWitness.archiveCode_eq_iff
  {F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution}
  {E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory} (W : SigmaWitness E)
  (s t : F.State) (l l' : E.protocol.Line) :
