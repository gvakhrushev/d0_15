D0.Foundation.VerificationCore.SigmaWitness.dmin_eq_iff {F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution}
  {E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory}
  (W : D0.Foundation.VerificationCore.SigmaWitness E) (s t : F.State) : W.dmin s = W.dmin t ↔ F.profile s = F.profile t
D0.Foundation.VerificationCore.SigmaWitness.dmin_canonical
  {F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution}
  {E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory}
  (W : D0.Foundation.VerificationCore.SigmaWitness E) (s : F.State) : W.coding.canon (W.dmin s) = W.dmin s
D0.Foundation.VerificationCore.SigmaWitness.dmin_minimal
  {F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution}
  {E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory}
  (W : D0.Foundation.VerificationCore.SigmaWitness E) (s : F.State) (c : List W.Symbol)
  (h : W.coding.decode c = some (Sum.inl (D0.Foundation.VerificationCore.representedState E s))) :
  D0.Foundation.VerificationCore.ShortlexLE (W.dmin s) c
D0.Foundation.VerificationCore.SigmaWitness.coded_verification_core
  {F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution}
  {E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory}
  (W : D0.Foundation.VerificationCore.SigmaWitness E) :
  D0.Foundation.VerifiabilityNecessity.FunctionalTuple E.protocol ∧
    (∀ (s t : F.State), W.dmin s = W.dmin t ↔ F.profile s = F.profile t) ∧
      (∀ (s t : F.State), W.coding.delta (W.dmin s) (W.dmin t) = true ↔ F.profile s ≠ F.profile t) ∧
        (∀ (s t : F.State) (l l' : E.protocol.Line),
            W.archiveCode (s, l) = W.archiveCode (t, l') ↔ F.profile s = F.profile t ∧ l = l') ∧
          Computable W.coding.canon ∧ Computable₂ W.coding.delta ∧ Computable₂ W.query
D0.Foundation.VerificationCore.representedRecord_eq_iff {F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution}
  (E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.futureEmpiricalTheory) (s t : F.State) :
  D0.Foundation.VerificationCore.representedRecord E s = D0.Foundation.VerificationCore.representedRecord E t ↔
    F.profile s = F.profile t
D0.Foundation.EmpiricalTheoryFactorization.FutureExecution.uncoupledCenter_profile_independent
  (F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution) (s : F.State) (b b' : Bool) :
  F.uncoupledCenter.profile (s, b) = F.uncoupledCenter.profile (s, b')
D0.Foundation.UncoupledCenterRawWitness.distinct_raw_same_future_and_record
  (F : D0.Foundation.EmpiricalTheoryFactorization.FutureExecution) (s : F.State)
  (E : D0.Foundation.VerifiabilityNecessity.TheoryVerification F.uncoupledCenter.futureEmpiricalTheory) :
  ∃ x y,
    x ≠ y ∧
      F.uncoupledCenter.profile x = F.uncoupledCenter.profile y ∧
        D0.Foundation.VerificationCore.representedRecord E x = D0.Foundation.VerificationCore.representedRecord E y
D0.Foundation.UncoupledCenterRawWitness.concrete_distinct_raw_same_future_and_record :
  ∃ x y,
    x ≠ y ∧
      D0.Foundation.TheoryTransfer.visibleBitSystem.profile x =
          D0.Foundation.TheoryTransfer.visibleBitSystem.profile y ∧
        D0.Foundation.VerificationCore.representedRecord
            D0.Foundation.VerificationTransferApplication.visibleBitVerification x =
          D0.Foundation.VerificationCore.representedRecord
            D0.Foundation.VerificationTransferApplication.visibleBitVerification y
