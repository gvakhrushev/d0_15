D0.Analysis.MovingProjectorBookPrice.hasDerivAt_variable_feedback_logdet.{u_1} {ι : Type u_1} [Fintype ι]
  [DecidableEq ι] {z : ℝ → ℝ} {P U : ℝ → Matrix ι ι ℂ} {dz : ℝ} {dP dU : Matrix ι ι ℂ} {t : ℝ} (hz : HasDerivAt z dz t)
  (hP : HasDerivAt P dP t) (hU : HasDerivAt U dU t) (hIdem : ∀ᶠ (s : ℝ) in nhds t, P s * P s = P s)
  (hSelf : ∀ᶠ (s : ℝ) in nhds t, star (P s) = P s)
  (hSlit :
    (1 -
          ↑(z t) •
            (star (D0.Algebra.MovingProjectorTransport.cut (P t) (U t)) *
