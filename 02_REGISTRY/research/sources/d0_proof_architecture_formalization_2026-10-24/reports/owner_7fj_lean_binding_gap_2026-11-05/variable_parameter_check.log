def D0.Analysis.MovingProjectorBookPrice.variableMovingProjectorHeatSource.{u_1} : {ι : Type u_1} →
  [Fintype ι] → [DecidableEq ι] → ℝ → Matrix ι ι ℂ → ℝ → Matrix ι ι ℂ → Matrix ι ι ℂ → Matrix ι ι ℂ → ℝ :=
fun {ι} [Fintype ι] [DecidableEq ι] β Δ dβ dP dΔ P =>
  have K := D0.Algebra.MovingProjectorTransport.generator P dP;
  have Z := D0.Analysis.matrixHeatPartition β Δ;
  have ρ := D0.Analysis.MovingProjectorBookPrice.matrixThermalState β Δ;
  -(ρ * (dΔ - D0.Algebra.MovingProjectorTransport.comm K Δ)).trace.re +
    (-Real.log Z / β ^ 2 - (ρ * Δ).trace.re / β) * dβ
def D0.Analysis.MovingProjectorBookPrice.variableMovingProjectorFeedbackSource.{u_1} : {ι : Type u_1} →
  [Fintype ι] → [DecidableEq ι] → ℝ → Matrix ι ι ℂ → Matrix ι ι ℂ → ℝ → Matrix ι ι ℂ → Matrix ι ι ℂ → ℝ :=
fun {ι} [Fintype ι] [DecidableEq ι] z P U dz dP dU =>
  have K := D0.Algebra.MovingProjectorTransport.generator P dP;
  have C := D0.Algebra.MovingProjectorTransport.cut P U;
  have F := star C * C;
  have R := (1 - ↑z • F)⁻¹;
  have V := (1 - P) * (dU - D0.Algebra.MovingProjectorTransport.comm K U) * P;
  z * (2 * (R * star C * V).trace.re) + dz * (R * F).trace.re
