  (hβ : HasDerivAt β dβ t) (hβne : β t ≠ 0) (hΔ : HasDerivAt Δ dΔ t) (hHerm : star (Δ t) = Δ t) :
  have Z := D0.Analysis.matrixHeatPartition (β t) (Δ t);
