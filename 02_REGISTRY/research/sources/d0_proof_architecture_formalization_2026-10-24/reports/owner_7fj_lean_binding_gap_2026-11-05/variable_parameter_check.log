      Complex.slitPlane) :
  have C := D0.Algebra.MovingProjectorTransport.cut (P t) (U t);
  have F := star C * C;
  have R := (1 - ↑(z t) • F)⁻¹;
  have V :=
    (1 - P t) *
        (dU - D0.Algebra.MovingProjectorTransport.comm (D0.Algebra.MovingProjectorTransport.generator (P t) dP) (U t)) *
      P t;
  HasDerivAt
    (fun s =>
      -Real.log
          (1 -
                ↑(z s) •
                  (star (D0.Algebra.MovingProjectorTransport.cut (P s) (U s)) *
