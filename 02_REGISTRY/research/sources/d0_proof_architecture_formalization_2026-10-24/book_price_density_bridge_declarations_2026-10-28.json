      "elaborated_type": "∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] [Nonempty ι] (β z : ℝ) {Δ P U : ℝ → Matrix ι ι ℂ}\n  {dΔ dP dU : Matrix ι ι ℂ} {t : ℝ},\n  β ≠ 0 →\n    0 ≤ z →\n      z < 1 →\n        HasDerivAt Δ dΔ t →\n          star (Δ t) = Δ t →\n            HasDerivAt P dP t →\n              HasDerivAt U dU t →\n                (∀ᶠ (s : ℝ) in nhds t, P s * P s = P s) →\n                  (∀ᶠ (s : ℝ) in nhds t, star (P s) = P s) →\n                    star (U t) * U t = 1 →\n                      have K := D0.Algebra.MovingProjectorTransport.generator (P t) dP;\n                      have ρ := D0.Analysis.MovingProjectorBookPrice.matrixThermalState β (Δ t);\n                      have C := D0.Algebra.MovingProjectorTransport.cut (P t) (U t);\n                      have R := (1 - ↑z • (star C * C))⁻¹;\n                      have V := (1 - P t) * (dU - D0.Algebra.MovingProjectorTransport.comm K (U t)) * P t;\n                      HasDerivAt (fun s => D0.Analysis.MovingProjectorBookPrice.matrixBook03Price β z Δ P U s)\n                        (-(ρ * (dΔ - D0.Algebra.MovingProjectorTransport.comm K (Δ t))).trace.re +\n                          z * (2 * (R * star C * V).trace.re))\n                        t",
