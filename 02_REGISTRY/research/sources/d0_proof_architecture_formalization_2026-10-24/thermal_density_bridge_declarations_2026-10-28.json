      "conclusion_whnf": "star (NormedSpace.exp (-β • Δ t)).trace = (NormedSpace.exp (-β • Δ t)).trace ∧\n  star\n        (NormedSpace.exp (-β • Δ t) *\n            (dΔ -\n              D0.Algebra.MovingProjectorTransport.comm (D0.Algebra.MovingProjectorTransport.generator (P t) dP)\n                (Δ t))).trace =\n      (NormedSpace.exp (-β • Δ t) *\n          (dΔ -\n            D0.Algebra.MovingProjectorTransport.comm (D0.Algebra.MovingProjectorTransport.generator (P t) dP)\n              (Δ t))).trace ∧\n    ↑(-(NormedSpace.exp (-β • Δ t) *\n                    (dΔ -\n                      D0.Algebra.MovingProjectorTransport.comm (D0.Algebra.MovingProjectorTransport.generator (P t) dP)\n                        (Δ t))).trace.re /\n            D0.Analysis.matrixHeatPartition β (Δ t)) =\n        -(D0.Algebra.MovingProjectorTransport.matrixThermalDensity β (Δ t) *\n              (dΔ -\n                D0.Algebra.MovingProjectorTransport.comm (D0.Algebra.MovingProjectorTransport.generator (P t) dP)\n                  (Δ t))).trace ∧\n      (D0.Algebra.MovingProjectorTransport.matrixThermalDensity β (Δ t)).trace = 1 ∧\n        HasDerivAt (fun s => D0.Algebra.MovingProjectorTransport.movingHeatFeedback β z (P s) (U s) (Δ s))\n          (-(D0.Algebra.MovingProjectorTransport.matrixThermalDensity β (Δ t) *\n                    (dΔ -\n                      D0.Algebra.MovingProjectorTransport.comm (D0.Algebra.MovingProjectorTransport.generator (P t) dP)\n                        (Δ t))).trace.re +\n            z *\n              (2 *\n                ((1 -\n                            ↑z •\n                              (star (D0.Algebra.MovingProjectorTransport.cut (P t) (U t)) *\n                                D0.Algebra.MovingProjectorTransport.cut (P t) (U t)))⁻¹ *\n                        star (D0.Algebra.MovingProjectorTransport.cut (P t) (U t)) *\n                      ((1 - P t) *\n                          (dU -\n                            D0.Algebra.MovingProjectorTransport.comm\n                              (D0.Algebra.MovingProjectorTransport.generator (P t) dP) (U t)) *\n                        P t)).trace.re))\n          t",
