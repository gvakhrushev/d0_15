      "elaborated_type": "∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] [Nonempty ι] {P U Δ : ℝ → Matrix ι ι ℂ}\n  {dP dU dΔ : Matrix ι ι ℂ} {t : ℝ} (β z : ℝ),\n  β ≠ 0 →\n    0 ≤ z →\n      z < 1 →\n        HasDerivAt P dP t →\n          HasDerivAt U dU t →\n            HasDerivAt Δ dΔ t →\n              (∀ᶠ (s : ℝ) in nhds t, P s * P s = P s) →\n                (∀ᶠ (s : ℝ) in nhds t, star (P s) = P s) →\n                  star (U t) * U t = 1 →\n                    (∀ᶠ (s : ℝ) in nhds t, star (Δ s) = Δ s) →\n                      have K := D0.Algebra.MovingProjectorTransport.generator (P t) dP;\n                      have C := D0.Algebra.MovingProjectorTransport.cut (P t) (U t);\n                      have R := (1 - ↑z • (star C * C))⁻¹;\n                      have V := (1 - P t) * (dU - D0.Algebra.MovingProjectorTransport.comm K (U t)) * P t;\n                      have E := NormedSpace.exp (-β • Δ t);\n                      have Z := D0.Analysis.matrixHeatPartition β (Δ t);\n                      have ρ := D0.Algebra.MovingProjectorTransport.matrixThermalDensity β (Δ t);\n                      star E.trace = E.trace ∧\n                        star (E * (dΔ - D0.Algebra.MovingProjectorTransport.comm K (Δ t))).trace =\n                            (E * (dΔ - D0.Algebra.MovingProjectorTransport.comm K (Δ t))).trace ∧\n                          ↑(-(E * (dΔ - D0.Algebra.MovingProjectorTransport.comm K (Δ t))).trace.re / Z) =\n                              -(ρ * (dΔ - D0.Algebra.MovingProjectorTransport.comm K (Δ t))).trace ∧\n                            ρ.trace = 1 ∧\n                              HasDerivAt\n                                (fun s => D0.Algebra.MovingProjectorTransport.movingHeatFeedback β z (P s) (U s) (Δ s))\n                                (-(ρ * (dΔ - D0.Algebra.MovingProjectorTransport.comm K (Δ t))).trace.re +\n                                  z * (2 * (R * star C * V).trace.re))\n                                t",
