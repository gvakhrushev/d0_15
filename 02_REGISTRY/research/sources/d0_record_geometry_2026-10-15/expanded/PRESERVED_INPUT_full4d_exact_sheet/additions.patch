+ with tempfile.TemporaryDirectory() as td:
+  d=Path(td)
+  for p in R.glob('*.py'):shutil.copy2(p,d/p.name)
+  shutil.copy2(R/'center.json',d/'center.json')
+  f=d/file;txt=f.read_text()
